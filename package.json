{
  "private": true,
  "scripts": {
    "preview": "live-server --port=3000 --no-browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:html": "html-validate \"index.html\" \"tutoriais.html\" \"demos/**/*.html\" \"labs/**/*.html\" \"videotutoriais/**/*.html\"",
    "check:css": "stylelint \"**/*.css\" --ignore-pattern \"node_modules/**\"",
    "check": "npm run check:html && npm run check:css",
    "search": "rg --hidden --glob '!.git/**' --glob '!node_modules/**'"
  },
  "devDependencies": {
    "html-validate": "^11.16.0",
    "live-server": "^1.2.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
